{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-12-05",
  "name": "enpitsulin-dev",
  "main": "dist/server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enpitsulin-dev",
      "database_id": "665d7a3a-6e3f-4c51-9fcf-d1d0f806004a",
      "migrations_dir": "server/database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "enpitsulin-dev",
      "preview_id": "enpitsulin-dev-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "enpitsulin-dev"
    }
  ]
}
