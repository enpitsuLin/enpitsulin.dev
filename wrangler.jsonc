{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2025-12-05",
  "name": "enpitsulin-dev",
  "main": ".output/server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enpitsulin-dev",
      "database_id": "f8e5abb4-4eaa-4104-a8c9-f80877b93840",
      "migrations_dir": "server/database/migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "ad290536-3148-4b53-80cc-c21791d92be5",
      "preview_id": "enpitsulin-dev-preview"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "enpitsulin-dev"
    }
  ]
}
