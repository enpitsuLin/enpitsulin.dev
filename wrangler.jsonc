{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-04-03",
  "name": "enpitsulin-dev",
  "main": ".output/server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "enpitsulin-dev",
      "database_id": "f8e5abb4-4eaa-4104-a8c9-f80877b93840"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "enpitsulin-dev"
    }
  ]
}
