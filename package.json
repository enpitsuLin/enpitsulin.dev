{
  "name": "enpitsulin-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "pnpm run build && wrangler dev",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "cf-typegen": "wrangler types",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.30.0",
    "@nuxt/content": "3.10.0",
    "@nuxt/image": "2.0.0",
    "@nuxthub/core": "0.10.4",
    "@tanstack/vue-form": "^1.27.7",
    "@unocss/reset": "^66.5.12",
    "@vueuse/core": "^14.1.0",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.1",
    "feed": "^5.1.0",
    "lesetid": "^2.0.7",
    "motion-v": "^1.7.6",
    "nuxt": "^4.2.2",
    "nuxt-studio": "^1.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "ufo": "^1.6.2",
    "unstorage": "^1.17.3",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@iconify-json/carbon": "^1.2.15",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/mingcute": "^1.2.6",
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/eslint": "1.12.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/mdc": "^0.19.2",
    "@types/node": "^25.0.3",
    "@unocss/nuxt": "^66.5.12",
    "@unocss/preset-mini": "^66.5.12",
    "@unocss/preset-uno": "^66.5.12",
    "@vueuse/nuxt": "^14.1.0",
    "crossws": "0.3.5",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.2.0",
    "lint-staged": "^16.2.7",
    "nuxt-og-image": "^5.1.13",
    "prettier": "^3.7.4",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.12",
    "unplugin-vue-router": "^0.19.2",
    "wrangler": "^4.54.0"
  },
  "resolutions": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/kit": "^4.2.2",
    "nuxt": "^4.2.2",
    "sharp": "^0.34.5",
    "unplugin": "^2.3.11",
    "vite": "^7.3.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
