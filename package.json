{
  "name": "enpitsulin-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "pnpm run build && wrangler dev",
    "postinstall": "nuxt prepare",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enpitsulin-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio",
    "generate-auth-schema": "tsx scripts/generate-auth-schema.ts"
  },
  "dependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@ark-ui/vue": "^5.29.1",
    "@better-auth/passkey": "^1.4.1",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/image": "2.0.0",
    "@unocss/reset": "^66.5.9",
    "@vueuse/core": "^14.0.0",
    "better-auth": "^1.4.1",
    "drizzle-orm": "^0.44.7",
    "motion-v": "^1.7.4",
    "nuxt": "^4.2.1",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/mingcute": "^1.2.5",
    "@nuxtjs/color-mode": "^4.0.0",
    "@types/node": "^24.10.1",
    "@unocss/nuxt": "^66.5.9",
    "@unocss/preset-mini": "^66.5.9",
    "@unocss/preset-uno": "^66.5.9",
    "@vueuse/nuxt": "^14.0.0",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "lint-staged": "^16.2.7",
    "mimetext": "^3.0.27",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.9",
    "wrangler": "^4.50.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
