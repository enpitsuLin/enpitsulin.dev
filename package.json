{
  "name": "enpitsulin-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "pnpm run build && wrangler dev",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "cf-typegen": "wrangler types",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.36.2",
    "@nuxt/content": "3.10.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.0.0",
    "@nuxthub/core": "0.10.4",
    "@takumi-rs/core": "^1.1.2",
    "@takumi-rs/wasm": "^1.1.2",
    "@tanstack/vue-form": "^1.32.0",
    "@unocss/reset": "^66.6.8",
    "@vueuse/core": "^14.3.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "feed": "^5.2.1",
    "lesetid": "^2.1.1",
    "motion-v": "^2.2.1",
    "nuxt": "^4.4.5",
    "nuxt-studio": "^1.7.0",
    "rehype-unwrap-images": "^1.0.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@iconify-json/carbon": "^1.2.21",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/mingcute": "^1.2.7",
    "@nuxt/devtools": "^4.0.0-alpha.4",
    "@nuxt/eslint": "1.12.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/mdc": "^0.21.1",
    "@types/node": "^25.6.2",
    "@unocss/nuxt": "^66.6.8",
    "@unocss/preset-mini": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@vueuse/nuxt": "^14.3.0",
    "crossws": "0.3.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.0.4",
    "nuxt-og-image": "^6.5.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "unocss": "^66.6.8",
    "wrangler": "^4.90.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
