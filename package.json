{
  "name": "enpitsulin.dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "",
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "dev": "waku dev",
    "build": "waku build",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enpitsulin-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio",
    "generate-auth-schema": "tsx scripts/generate-auth-schema.ts",
    "postinstall": "pnpm simple-git-hooks"
  },
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@better-auth/passkey": "catalog:lib",
    "@unocss/reset": "catalog:lib",
    "better-auth": "catalog:lib",
    "clsx": "catalog:lib",
    "defu": "catalog:lib",
    "drizzle-orm": "catalog:server",
    "hono": "catalog:server",
    "motion": "catalog:lib",
    "react": "catalog:lib",
    "react-dom": "catalog:lib",
    "react-server-dom-webpack": "catalog:lib",
    "waku": "catalog:lib"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@hiogawa/node-loader-cloudflare": "catalog:dev",
    "@iconify-json/logos": "catalog:",
    "@iconify-json/mingcute": "catalog:",
    "@libsql/client": "catalog:dev",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@unocss/preset-mini": "catalog:dev",
    "@unocss/preset-uno": "catalog:dev",
    "@vitejs/plugin-react": "catalog:dev",
    "babel-plugin-react-compiler": "catalog:dev",
    "drizzle-kit": "catalog:dev",
    "eslint": "catalog:dev",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:dev",
    "miniflare": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:dev",
    "vite": "catalog:dev",
    "vite-plugin-inspect": "catalog:dev",
    "vite-tsconfig-paths": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
