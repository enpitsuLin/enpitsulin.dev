{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "up": "taze major -I",
    "postinstall": "npx simple-git-hooks",
    "sizecheck": "npx vite-bundle-visualizer",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enpitsulin-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio",
    "generate-auth-schema": "tsx scripts/generate-auth-schema.ts"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.29.0",
    "@better-auth/passkey": "^1.4.0",
    "@hono/zod-validator": "^0.7.5",
    "@libsql/client": "^0.15.15",
    "@pinia/colada": "^0.17.8",
    "@shikijs/langs": "^3.15.0",
    "@shikijs/rehype": "^3.15.0",
    "@shikijs/themes": "^3.15.0",
    "@shikijs/transformers": "^3.15.0",
    "@tanstack/vue-form": "^1.25.0",
    "@unhead/vue": "^2.0.19",
    "@unocss/reset": "^66.5.9",
    "@vueuse/core": "^14.0.0",
    "better-auth": "^1.4.0",
    "devalue": "^5.5.0",
    "drizzle-orm": "^0.44.7",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hono": "^4.10.6",
    "hookable": "^5.5.3",
    "mimetext": "^3.0.27",
    "motion-v": "^1.7.4",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^4.0.0",
    "remark-directive-rehype": "^0.4.2",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "ua-parser-js": "^2.0.6",
    "ufo": "^1.6.1",
    "unctx": "^2.4.1",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@cloudflare/vite-plugin": "^1.15.2",
    "@hiogawa/vite-plugin-fullstack": "^0.0.5",
    "@iconify-json/carbon": "^1.2.14",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/mingcute": "^1.2.5",
    "@types/hast": "^3.0.4",
    "@types/nprogress": "^0.2.3",
    "@unocss/eslint-config": "^66.5.9",
    "@unocss/preset-mini": "^66.5.9",
    "@unocss/preset-uno": "^66.5.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitejs/plugin-vue-jsx": "^5.1.2",
    "beasties": "^0.3.5",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rollup": "^4.53.3",
    "shiki": "^3.15.0",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unocss": "^66.5.9",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.17.1",
    "vite": "^7.2.4",
    "vite-bundle-visualizer": "^1.2.1",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.50.0"
  },
  "resolutions": {
    "unplugin": "^2.3.11",
    "vite": "^7.2.4",
    "vite-plugin-inspect": "^11.3.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
