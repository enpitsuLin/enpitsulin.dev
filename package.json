{
  "name": "enpitsulin.dev",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enpitsulin-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio",
    "generate-auth-schema": "tsx scripts/generate-auth-schema.ts",
    "postinstall": "pnpm simple-git-hooks"
  },
  "dependencies": {
    "@ark-ui/react": "catalog:components",
    "@better-auth/passkey": "catalog:better-auth",
    "@hookform/resolvers": "catalog:lib",
    "@tanstack/react-query": "catalog:lib",
    "@unocss/reset": "catalog:unocss",
    "better-auth": "catalog:better-auth",
    "clsx": "catalog:lib",
    "consola": "catalog:lib",
    "defu": "catalog:lib",
    "drizzle-orm": "catalog:server",
    "hono": "catalog:server",
    "motion": "catalog:components",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-hook-form": "catalog:lib",
    "unhead": "catalog:lib",
    "zod": "catalog:lib"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:eslint",
    "@cloudflare/vite-plugin": "catalog:vite",
    "@eslint-react/eslint-plugin": "catalog:eslint",
    "@iconify-json/logos": "catalog:unocss",
    "@iconify-json/mingcute": "catalog:unocss",
    "@libsql/client": "catalog:dev",
    "@types/node": "catalog:types",
    "@types/react": "catalog:types",
    "@types/react-dom": "catalog:types",
    "@unocss/preset-mini": "catalog:unocss",
    "@unocss/preset-uno": "catalog:unocss",
    "@vitejs/plugin-react": "catalog:vite",
    "@vitejs/plugin-rsc": "catalog:vite",
    "drizzle-kit": "catalog:dev",
    "eslint": "catalog:eslint",
    "eslint-plugin-react-hooks": "catalog:eslint",
    "eslint-plugin-react-refresh": "catalog:eslint",
    "jiti": "catalog:dev",
    "lint-staged": "catalog:dev",
    "rsc-html-stream": "catalog:rsc",
    "simple-git-hooks": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "unocss": "catalog:unocss",
    "vite": "catalog:vite",
    "vite-plugin-devtools-json": "catalog:vite",
    "vite-plugin-inspect": "catalog:vite",
    "vite-tsconfig-paths": "catalog:vite",
    "vitest": "catalog:vite",
    "wrangler": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
