{
  "name": "enpitsulin-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "pnpm run build && wrangler dev",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply enpitsulin-dev --local",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio"
  },
  "dependencies": {
    "@antfu/eslint-config": "^6.5.1",
    "@ark-ui/vue": "^5.29.1",
    "@nuxt/eslint": "1.10.0",
    "@nuxt/image": "2.0.0",
    "@pinia/colada": "^0.18.0",
    "@pinia/colada-nuxt": "0.2.4",
    "@tanstack/vue-form": "^1.27.1",
    "@unocss/reset": "^66.5.10",
    "@vueuse/core": "^14.1.0",
    "drizzle-orm": "^0.45.0",
    "motion-v": "^1.7.4",
    "nuxt": "^4.2.1",
    "rehype-unwrap-images": "^1.0.0",
    "remark-lesetid": "^2.0.7",
    "ua-parser-js": "^2.0.6",
    "ufo": "^1.6.1",
    "unstorage": "^1.17.3",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.15",
    "@iconify-json/logos": "^1.2.10",
    "@iconify-json/mingcute": "^1.2.5",
    "@libsql/client": "^0.15.15",
    "@nuxt/devtools": "^3.1.1",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/mdc": "^0.19.1",
    "@pinia/nuxt": "^0.11.3",
    "@types/node": "^24.10.1",
    "@unocss/nuxt": "^66.5.10",
    "@unocss/preset-mini": "^66.5.10",
    "@unocss/preset-uno": "^66.5.10",
    "@vueuse/nuxt": "^14.1.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.1.0",
    "lint-staged": "^16.2.7",
    "nuxt-auth-utils": "^0.5.25",
    "prettier": "^3.7.4",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "unocss": "^66.5.10",
    "unplugin-vue-router": "^0.19.0",
    "wrangler": "^4.53.0"
  },
  "resolutions": {
    "@nuxt/devtools": "^3.1.1",
    "@nuxt/kit": "^4.2.1",
    "nuxt": "^4.2.1",
    "sharp": "^0.34.5",
    "unplugin": "^2.3.11",
    "vite": "^7.2.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
