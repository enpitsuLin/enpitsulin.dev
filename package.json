{
  "name": "enpitsulin-dev",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "pnpm run build && wrangler dev",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "cf-typegen": "wrangler types",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate",
    "db:migrate:remote": "wrangler d1 migrations apply enpitsulin-dev --remote",
    "db:studio": "DATABASE_URL=\"$(ls -t ./.wrangler/state/v3/d1/**/*.sqlite | head -n 1)\" drizzle-kit studio"
  },
  "dependencies": {
    "@ark-ui/vue": "^5.39.2",
    "@nuxt/content": "3.10.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.0.0",
    "@nuxthub/core": "0.10.4",
    "@takumi-rs/core": "^2.14.0",
    "@takumi-rs/wasm": "^2.14.0",
    "@unocss/reset": "^66.10.5",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "feed": "^6.0.0",
    "lesetid": "^2.1.1",
    "motion-v": "^2.5.1",
    "nuxt": "^4.5.2",
    "nuxt-studio": "^1.7.0",
    "rehype-unwrap-images": "^1.0.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/mingcute": "^1.2.8",
    "@nuxt/devtools": "^4.0.0-beta.2",
    "@nuxt/eslint": "1.12.1",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/mdc": "^0.23.1",
    "@types/node": "^25.9.8",
    "@unocss/nuxt": "^66.10.5",
    "@unocss/preset-mini": "^66.10.5",
    "@unocss/preset-uno": "^66.10.5",
    "@vueuse/nuxt": "^15.0.0",
    "crossws": "0.3.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^17.6.0",
    "nuxt-og-image": "^6.9.1",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.142.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
