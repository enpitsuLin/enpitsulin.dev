{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["./worker-configuration.d.ts", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "downlevelIteration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
